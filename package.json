{
  "name": "minecraft-server-studio",
  "version": "0.1.0",
  "description": "A Windows desktop control center for Paper and Spigot Minecraft servers.",
  "main": "src/main/main.cjs",
  "author": "Ding Ding Projects",
  "license": "MIT",
  "scripts": {
    "start": "electron .",
    "start:cli": "node src/cli/mss.cjs",
    "test:release-catalog-archive": "node scripts/test-release-catalog-archive.cjs",
    "package": "node scripts/generate-release-catalog.cjs && node scripts/verify-offline-docs-bundle.cjs && node scripts/verify-offline-changelog-bundle.cjs && electron-builder --win squirrel",
    "package:dir": "node scripts/generate-release-catalog.cjs && node scripts/verify-offline-docs-bundle.cjs && node scripts/verify-offline-changelog-bundle.cjs && electron-builder --dir"
  },
  "devDependencies": {
    "electron": "^37.0.0",
    "electron-builder": "^26.0.12",
    "electron-builder-squirrel-windows": "26.15.3"
  },
  "build": {
    "appId": "com.dingdingprojects.minecraftserverstudio",
    "productName": "Minecraft Server Studio",
    "asar": true,
    "files": [
      "src/**/*",
      "docs/features/**/*",
      "CHANGELOG.md",
      "package.json"
    ],
    "forceCodeSigning": false,
    "win": {
      "icon": "assets/minecraft-server-studio.ico",
      "signExecutable": false,
      "signAndEditExecutable": false,
      "target": [
        {
          "target": "squirrel",
          "arch": [
            "x64"
          ]
        }
      ]
    },
    "squirrelWindows": {
      "artifactName": "Minecraft.Server.Studio-${version}-${arch}-Setup.exe",
      "iconUrl": "https://raw.githubusercontent.com/Ding-Ding-Projects/minecraft-server-studio/cf1e39526eeab1996e8ecdf4114e00c12577cd62/assets/minecraft-server-studio.ico",
      "msi": false
    }
  }
}
